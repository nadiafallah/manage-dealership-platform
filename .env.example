# Manage by HEDAX — environment template. Copy to .env and replace placeholders.
# Never commit a real .env. Never put production secrets in this file.

# development | test | preview | production
APP_ENV=development
TOTP_AUTH_ENABLED=false
# Base of invitation links. Production: https://managebyhedax.ir
PUBLIC_APP_URL=http://localhost:3000
# Generate once on the host and preserve it: encrypts Authenticator seeds.
AUTH_TOKEN_SECRET=

# Staff invitations. Use a dedicated Gmail App Password, never the Google login password.
# Private server configuration only; never commit actual credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- API ----
API_PORT=4000
# Comma-separated origins allowed to call the API directly (the web app proxies /api, so usually empty)
API_ALLOWED_ORIGINS=

# Database driver: "pglite" (embedded, zero-setup, local dev/demo only) or "postgres"
DB_DRIVER=pglite
# Used when DB_DRIVER=pglite. Relative to apps/api. Use "memory://" for an in-memory database.
PGLITE_DATA_DIR=.data/pglite
# Used when DB_DRIVER=postgres
DATABASE_URL=postgres://manage:CHANGE_ME@localhost:5432/manage

# Login attempts per minute per client address (leave empty for the default of 10)
LOGIN_RATE_LIMIT=

# Session lifetime in hours
SESSION_TTL_HOURS=12
# Set to true behind HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false

# Identifier of this deployment node for the sync change log (e.g. cloud, branch-lan-01)
NODE_ID=dev-local

# Demo seed: password for all demo accounts. Leave empty to generate a random one
# (written to apps/api/.data/demo-credentials.local.txt, which is git-ignored).
SEED_DEMO_PASSWORD=
# Synthetic demo fleet (~20 cars in every stage) on top of the five base cases.
# Only used where the demo seed runs (development, CI, Preview); Production never seeds.
DEMO_FLEET=true

# ---- Web ----
WEB_PORT=3000
# Where the Next.js server proxies /api/* requests
API_INTERNAL_URL=http://localhost:4000
# Set to true only behind a reverse proxy (Caddy/Nginx) that overwrites
# X-Forwarded-For; otherwise clients could spoof their address for rate limits.
TRUST_PROXY_HEADERS=false

# ---- docker compose only ----
POSTGRES_PASSWORD=CHANGE_ME
